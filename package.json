{
  "name": "pr-denoise",
  "description": "GTCRN-based real-time noise suppression for pr-audio-stream",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "build": "tsc && vite build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "private": false,
  "author": "Breathe",
  "keywords": [
    "pr-denoise",
    "gtcrn",
    "noise-suppression"
  ]
